# Lead delivery — both channels optional. Set the ones you use; unset ones
# are skipped silently. Copy this file to `.env` and fill in real values.

# --- Resend (email notifications) ---
# Get a key at https://resend.com → API Keys. Free tier ~3k/mo.
# RESEND_FROM must be a verified domain (or Resend's onboarding test domain).
RESEND_API_KEY=
RESEND_FROM="Arcani Studio <leads@yourdomain.com>"
LEAD_NOTIFY_EMAIL=you@yourdomain.com

# --- Telegram (instant phone notification) ---
# 1. Message @BotFather → /newbot → copy the token.
# 2. Message your new bot once, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Airtable (backup lead archive — every lead is logged here regardless of
# whether email/Telegram succeed; failures here are logged server-side only
# and never block or error the visitor's submission) ---
# 1. Create a free account at https://airtable.com and a new Base.
# 2. In the Base, create a table named "Leads" (or set AIRTABLE_TABLE_NAME
#    below to match whatever name you use) with these columns (exact names,
#    case-sensitive — Airtable rejects unknown field names):
#      Project        — Single line text
#      Timeline       — Single line text
#      Company        — Single line text
#      Budget         — Single line text
#      Name           — Single line text
#      Email          — Single line text (or Email field type)
#      Phone          — Single line text (or Phone field type)
#      Business       — Single line text
#      Message        — Long text
#      Lang           — Single select (options: en, fr)
#      Submitted At   — Date (include time)
# 3. Create a Personal Access Token at https://airtable.com/create/tokens
#    with scopes `data.records:write` + `data.records:read`, access
#    limited to the Base you just created.
# 4. Base ID: open the Base, check the URL — the "appXXXXXXXXXXXXXX" segment
#    is AIRTABLE_BASE_ID.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# --- cal.com (used by the frontend redirect after submit) ---
# Public env var (PUBLIC_ prefix) so the client island can read it.
# Event 2 = "already qualified" booking link, e.g. https://cal.com/arcani/qualified-call
PUBLIC_CALCOM_URL=
