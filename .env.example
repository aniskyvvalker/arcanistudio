# Lead delivery — both channels optional. Set the ones you use; unset ones
# are skipped silently. Copy this file to `.env` and fill in real values.

# --- Resend (email notifications) ---
# Get a key at https://resend.com → API Keys. Free tier ~3k/mo.
# RESEND_FROM must be a verified domain (or Resend's onboarding test domain).
RESEND_API_KEY=
RESEND_FROM="Arcani Studio <leads@yourdomain.com>"
LEAD_NOTIFY_EMAIL=you@yourdomain.com

# --- Telegram (instant phone notification) ---
# 1. Message @BotFather → /newbot → copy the token.
# 2. Message your new bot once, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Airtable (backup lead archive — every lead is logged here regardless of
# whether email/Telegram succeed; failures here are logged server-side only
# and never block or error the visitor's submission) ---
# 1. Create a free account at https://airtable.com and a new Base.
# 2. In the Base, create a table named "Leads" (or set AIRTABLE_TABLE_NAME
#    below to match whatever name you use) with these columns (exact names,
#    case-sensitive — Airtable rejects unknown field names):
#      Project        — Single line text
#      Timeline       — Single line text
#      Goal           — Single line text (the form's "Company" answer, for
#                        non-management-software leads)
#      Business size  — Single line text (same answer, but for
#                        "Custom management software (ERP / CRM)" leads —
#                        the two are mutually exclusive per row, only one
#                        is ever filled)
#      Budget         — Single line text
#      Name           — Single line text
#      Email          — Single line text (or Email field type)
#      Phone          — Single line text (or Phone field type)
#      Business       — Single line text
#      Message        — Long text
#      Lang           — Single select (options: en, fr)
#      Submitted At   — Date (include time)
# 3. Create a Personal Access Token at https://airtable.com/create/tokens
#    with scopes `data.records:write` + `data.records:read`, access
#    limited to the Base you just created.
# 4. Base ID: open the Base, check the URL — the "appXXXXXXXXXXXXXX" segment
#    is AIRTABLE_BASE_ID.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# --- Google Sheets (second, independent backup archive — same deal as
# Airtable: every lead logged, failures here never block or error the
# visitor's submission. Uses a Google Apps Script Web App instead of the
# official Sheets API, so there's no OAuth/service-account setup) ---
# 1. Create a Google Sheet. Row 1 (headers), in this exact order:
#      Name | Project | Timeline | Goal | Business size | Budget | Email |
#      Phone | Business | Message | Lang | Submitted At
# 2. Extensions → Apps Script. Replace the default code with:
#
#      var SHARED_SECRET = 'paste-a-random-string-here'; // must match
#                                                          // GOOGLE_SHEETS_SECRET below
#
#      function doPost(e) {
#        var body = JSON.parse(e.postData.contents);
#        if (body.secret !== SHARED_SECRET) {
#          return ContentService.createTextOutput('Forbidden');
#        }
#        var f = body.fields || {};
#        SpreadsheetApp.getActiveSpreadsheet().getActiveSheet().appendRow([
#          f.Name, f.Project, f.Timeline, f.Goal, f['Business size'], f.Budget,
#          f.Email, f.Phone, f.Business, f.Message, f.Lang, f['Submitted At']
#        ]);
#        return ContentService.createTextOutput('OK');
#      }
#
#    Pick your own random string for SHARED_SECRET (anything long/unguessable
#    works — this is the only thing standing between the public URL below and
#    anyone being able to write rows, since Apps Script Web Apps don't support
#    custom Authorization headers without full OAuth).
# 3. Deploy → New deployment → type "Web app" → Execute as "Me" → Who has
#    access "Anyone" → Deploy. Copy the Web app URL (ends in /exec).
#    NOTE: if you ever edit the script afterwards, you must re-deploy (Deploy
#    → Manage deployments → edit → "New version" → Deploy) for the live URL
#    to pick up the change — editing the script alone does nothing.
# 4. GOOGLE_SHEETS_SECRET below must match SHARED_SECRET in the script exactly.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# --- cal.com (used by the frontend redirect after submit) ---
# Public env var (PUBLIC_ prefix) so the client island can read it.
# Event 2 = "already qualified" booking link, e.g. https://cal.com/arcani/qualified-call
PUBLIC_CALCOM_URL=

# --- Google Analytics (GA4) ---
# Public env var (PUBLIC_ prefix) — the tag is client-side JS, no secret here.
# Only loads on production builds; unset or dev builds skip it entirely, so
# local testing never pollutes real GA data.
# 1. https://analytics.google.com → Admin → Create property.
# 2. Add a "Web" data stream, use the current site URL (vercel.app for now,
#    swap to the real domain later — takes 30s, no need to wait for it).
# 3. Copy the Measurement ID (starts with "G-").
PUBLIC_GA_MEASUREMENT_ID=

# --- Microsoft Clarity (heatmaps + session replay) ---
# Public env var (PUBLIC_ prefix) — client-side tag, no secret here.
# Only loads on production builds, same as GA4 above.
# 1. https://clarity.microsoft.com → New project → use the current site URL.
# 2. Copy the Project ID (Settings → Setup → shown in the tag, a short
#    alphanumeric string, not a URL).
PUBLIC_CLARITY_PROJECT_ID=
