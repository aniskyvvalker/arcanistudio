---
import FAQList from './FAQList'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang).faq
---

<section id="faq" class="bg-palette-950 py-[clamp(80px,10vw,128px)]">
  <div class="mx-auto max-w-7xl px-5">
    <div class="grid gap-12 md:grid-cols-[0.85fr_1.15fr] md:gap-16">

      <!-- Left — sticky intro -->
      <div class="md:sticky md:top-28 md:self-start">
        <div class="mb-5 flex items-center gap-3">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 1 C12.6 7 14 10.6 22 12 C14 13.4 12.6 17 12 23 C11.4 17 10 13.4 2 12 C10 10.6 11.4 7 12 1 Z" fill="#F94500" />
          </svg>
          <p class="text-tooltip-l font-regular uppercase text-primary-600">{t.eyebrow}</p>
        </div>
        <h2 class="font-sans text-[clamp(32px,4vw,56px)] font-medium leading-[1.08] text-white">
          {t.headingLine1}<br />
          <em class="font-reckless font-light not-italic text-primary-600">{t.headingEm}</em>
        </h2>
        <p class:list={['mt-5 text-[15px] leading-relaxed text-palette-400', lang === 'fr' ? 'max-w-[340px]' : 'max-w-xs']}>
          {t.intro}
        </p>
      </div>

      <!-- Right — animated accordion -->
      <FAQList client:visible lang={lang} />

    </div>
  </div>
</section>
