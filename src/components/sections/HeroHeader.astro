---
import { Sparkles } from 'lucide-react'
import { Wormhole } from '../Wormhole'
---

<section class="relative flex min-h-[80vh] flex-col items-center justify-center">
  <div class="relative z-10 mx-auto flex max-w-3xl flex-col items-center gap-6 px-4 text-center">
    <div
      class="flex items-center gap-2 rounded-full border border-palette-200 bg-white px-3 py-1 text-tooltip-l text-palette-600"
    >
      <span
        class="flex items-center gap-1 rounded-full bg-primary-500 px-2 py-0.5 text-tooltip-s font-semibold uppercase text-white"
      >
        <Sparkles size={10} />
        New
      </span>
      <span>Now booking projects for next quarter</span>
    </div>

    <h1 class="text-[clamp(40px,3.8vw+25px,64px)] leading-[1.05] font-semibold text-palette-950">
      <span class="block whitespace-nowrap">Unleash Your</span><span class="block whitespace-nowrap">Digital Potential</span>
    </h1>

    <p class="max-w-2xl text-subtitle text-palette-600">
      You bring the vision. We bring it to life — 
      design, code, testing, and deployment fully handled so you can focus on your business.
    </p>

    <div class="relative">
      <a
        href="#contact"
        class="rounded-full bg-black px-6 py-3 text-p-bold font-semibold text-white transition-colors hover:bg-palette-800"
      >
        Get started
      </a>

      <div class="wormhole-fade pointer-events-none absolute left-1/2 top-1/2 -z-10 w-[1400px] max-w-none -translate-x-1/2 -translate-y-[53%] overflow-hidden sm:w-[1800px] md:w-[2100px] lg:w-[2400px]">
        <Wormhole client:visible className="h-auto w-full" />
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 top-0 z-20 hidden h-32 md:block md:h-48 bg-[radial-gradient(circle_at_top_left,#F8F6F1_0%,transparent_45%),radial-gradient(circle_at_top_right,#F8F6F1_0%,transparent_45%),linear-gradient(to_bottom,#F8F6F1_0%,transparent_100%)]"></div>
</section>
