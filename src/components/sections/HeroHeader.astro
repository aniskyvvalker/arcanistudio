---
import { Sparkles } from 'lucide-react'
import { Wormhole } from '../Wormhole'
---

<section class="relative flex min-h-screen flex-col items-center justify-center">
  <div class="wormhole-fade pointer-events-none absolute inset-x-0 top-64 -z-10 flex justify-center overflow-hidden">
    <Wormhole client:visible className="h-auto w-[2400px] max-w-none" />
    <div class="wormhole-light absolute inset-0"></div>
  </div>

  <div class="relative z-10 mx-auto flex max-w-3xl flex-col items-center gap-6 px-4 text-center">
    <div
      class="flex items-center gap-2 rounded-full border border-palette-200 bg-white px-3 py-1 text-tooltip-l text-palette-600"
    >
      <span
        class="flex items-center gap-1 rounded-full bg-primary-500 px-2 py-0.5 text-tooltip-s font-semibold uppercase text-white"
      >
        <Sparkles size={10} />
        New
      </span>
      <span>Now booking projects for next quarter</span>
    </div>

    <h1 class="text-h1 font-semibold text-palette-950">
      Brands built with care,<br />launched with impact
    </h1>

    <p class="max-w-xl text-subtitle text-palette-600">
      We design and build digital experiences for ambitious brands —
      from strategy and identity to product and growth.
    </p>

    <a
      href="#contact"
      class="rounded-full bg-black px-6 py-3 text-p-bold font-semibold text-white transition-colors hover:bg-palette-800"
    >
      Get started
    </a>
  </div>
</section>
