---
import { ChevronRight, Sparkles } from 'lucide-react'
import { Wormhole } from '../Wormhole'
---

<section class="relative flex min-h-[80vh] flex-col items-center justify-center">
  <div class="relative z-10 mx-auto flex max-w-3xl flex-col items-center gap-6 px-4 text-center">
    <div
      class="flex items-center gap-2 rounded-full border border-palette-200 bg-white px-3 py-1 text-tooltip-l text-palette-600"
    >
      <span
        class="flex items-center gap-1 rounded-full bg-primary-500 px-2 py-0.5 text-tooltip-s font-semibold uppercase text-white"
      >
        <Sparkles size={10} />
        New
      </span>
      <span>Now booking projects for next quarter</span>
    </div>

    <h1 class="text-[clamp(40px,3.69vw+26.9px,80px)] leading-[1.05] font-semibold text-palette-950">
      <span class="block whitespace-nowrap font-medium">Unleash Your</span><span class="block whitespace-nowrap font-reckless font-normal text-primary-700">Digital Potential</span>
    </h1>

    <p class="max-w-2xl text-h6 text-palette-600">
      You bring the vision. We bring it to life — 
      design, code, testing, and deployment fully handled so you can focus on your business.
    </p>

    <div class="relative">
      <a
        href="#contact"
        class="group flex items-center gap-3 rounded-full bg-primary-600 py-2 pl-5 pr-2 text-[16px] font-light text-white"
      >
        <span class="relative h-[1.2em] overflow-hidden">
          <span class="flex h-full items-center transition-transform duration-500 group-hover:-translate-y-[150%]">Book A Call</span>
          <span class="absolute left-0 top-0 flex h-full translate-y-[150%] items-center transition-transform duration-500 group-hover:translate-y-0">Book A Call</span>
        </span>
        <span class="relative flex h-8 w-8 items-center justify-center overflow-hidden rounded-full bg-white text-palette-950">
          <ChevronRight size={24} strokeWidth={1.5} className="transition-transform duration-500 group-hover:translate-x-8" />
          <ChevronRight size={24} strokeWidth={1.5} className="absolute -translate-x-8 transition-transform duration-500 group-hover:translate-x-0" />
        </span>
      </a>

      <div class="wormhole-fade pointer-events-none absolute left-1/2 top-1/2 -z-10 w-[1400px] max-w-none -translate-x-1/2 -translate-y-[53%] overflow-hidden sm:w-[1800px] md:w-[2100px] lg:w-[2400px]">
        <Wormhole client:visible className="h-auto w-full" />
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 top-0 z-20 hidden h-32 md:block md:h-48 bg-[radial-gradient(circle_at_top_left,#F8F6F1_0%,transparent_45%),radial-gradient(circle_at_top_right,#F8F6F1_0%,transparent_45%),linear-gradient(to_bottom,#F8F6F1_0%,transparent_100%)]"></div>
</section>
