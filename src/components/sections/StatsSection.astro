---
import { ArrowRight } from 'lucide-react'
import { AnimatedCounter } from '../AnimatedCounter'

const stats = [
  {
    value: '40+',
    label: 'Websites launched',
    description: 'For founders and brands who take their digital presence seriously.',
  },
  {
    value: '38%',
    label: 'Average conversion lift',
    description: 'Typical improvement clients see within six months',
  },
  {
    value: '4.9',
    label: 'Average client rating',
    description: "Because you don't just meet expectations; you exceed them",
  },
]
---

<section class="bg-palette-950 pb-24 rounded-b-2xl" style="padding-top: clamp(70px, 56.5px + 3.857vw, 96px);">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 md:grid-cols-[2fr_1fr_1fr] md:gap-8">
    <div class="flex flex-col gap-4">
      <div class="mb-6 flex items-center gap-3">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M12 1 C12.6 7 14 10.6 22 12 C14 13.4 12.6 17 12 23 C11.4 17 10 13.4 2 12 C10 10.6 11.4 7 12 1 Z"
            fill="#F94500"
          />
        </svg>
        <p class="text-tooltip-l font-regular uppercase text-primary-600">Proof</p>
      </div>
      <h2 class="text-h2 font-semibold text-white">Numbers that speak for themselves</h2>
      <p class="text-subtitle text-palette-400">We lead digital projects built for measurable results.<!-- FR: On pilote des projets digitaux conçus pour des résultats mesurables. --></p>

      <div class="mt-4 flex items-center gap-4">
        <a
          href="#contact"
          class="rounded-full border border-palette-700 px-6 py-3 text-p-bold font-semibold text-white transition-colors hover:bg-palette-800"
        >
          Quote
        </a>
        <a
          href="#work"
          class="flex items-center gap-1 text-p-bold font-semibold text-white transition-colors hover:text-primary-500"
        >
          Discover
          <ArrowRight size={16} />
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-10">
      {stats.slice(0, 2).map(({ value, label, description }) => (
        <div class="border-l border-palette-800 pl-6">
          <AnimatedCounter client:visible value={value} className="text-h1 font-normal text-white" />
          <p class="mt-2 text-p-bold font-semibold text-white">{label}</p>
          <p class="mt-1 text-p-regular font-light text-palette-400">{description}</p>
        </div>
      ))}
    </div>

    <div class="flex flex-col">
      {stats.slice(2, 3).map(({ value, label, description }) => (
        <div class="border-l border-palette-800 pl-6">
          <AnimatedCounter client:visible value={value} className="text-h1 font-normal text-white" />
          <p class="mt-2 text-p-bold font-semibold text-white">{label}</p>
          <p class="mt-1 text-p-regular font-light text-palette-400">{description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
