---
import { Image } from 'astro:assets'
// import { Atom, Hexagon, Layers, Sparkle, Zap } from 'lucide-react'
import { ScrollGlow } from '../ScrollGlow'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'

const t = useTranslations(getLangFromUrl(Astro.url)).logos

import dentalCareSeattle from '../../assets/logos/dental-care-seattle-gray.webp'
import dentalCareSeattleMark from '../../assets/logos/dental-care-seattle-favicon-gray.webp'
import cafeBuade from '../../assets/logos/cafe-buade-gray.webp'
import popPop from '../../assets/logos/pop-pop-gray.webp'
import skyDental from '../../assets/logos/sky-dental.svg'
import sevenHills from '../../assets/logos/sevenhills-gray.webp'
import syncBrokerage from '../../assets/logos/sync-brokerage-gray.webp'
import capleCo from '../../assets/logos/caple-co-gray.webp'
import suntria from '../../assets/logos/suntria.svg'
import arthurYeh from '../../assets/logos/arthur-yeh-mark-gray.webp'
import axels from '../../assets/logos/axels-mark-gray.webp'
import orvosh from '../../assets/logos/orvosh-gray.webp'
import mamac from '../../assets/logos/mamac-gray.webp'
import jj from '../../assets/logos/jj-gray.webp'
import sherGroup from '../../assets/logos/sher-group-gray.webp'
import sherGroupWhite from '../../assets/logos/sher-group-white-gray.webp'
import bLogo from '../../assets/logos/b-logo-gray.webp'

const logos = [
  // ── Original lucide icon placeholders (disabled) ──────────────────────────
  // Replaced by the real client logos below. To restore them, uncomment these
  // lines AND re-enable the lucide import at the top of this file.
  // The `icon` render branch further down is still in place to support them.
  // { label: 'Nordica', icon: Atom },
  // { label: 'Acme Co', icon: Sparkle },
  // { label: 'Lumen', icon: Zap },
  // { label: 'Vertex', icon: Layers },
  // { label: 'Sphere', icon: Hexagon },
  // ── Real client logos (grayscale, transparent bg) ─────────────────────────
  // `label` is alt text only (not rendered) — kept neutral, not the real
  // client/brand name, so client identity isn't exposed via page source.
  { label: 'Client logo', src: dentalCareSeattle, mark: dentalCareSeattleMark },
  { label: 'Client logo', src: cafeBuade, imgClass: 'h-9' },
  { label: 'Client logo', src: popPop, imgClass: 'h-8' },
  { label: 'Client logo', src: skyDental, imgClass: 'h-9' },
  { label: 'Client logo', src: sevenHills, imgClass: 'h-8' },
  { label: 'Client logo', src: syncBrokerage, imgClass: 'h-9' },
  { label: 'Client logo', src: sherGroup, imgClass: 'h-10' },
  { label: 'Client logo', src: bLogo, imgClass: 'h-8' },
  { label: 'Client logo', src: capleCo, imgClass: 'h-9' },
  { label: 'Client logo', src: suntria, imgClass: 'h-6' },
  { label: 'Client logo', src: arthurYeh, imgClass: 'h-8', opacity: 0.85 },
  { label: 'Client logo', src: axels, imgClass: 'h-9' },
  { label: 'Client logo', src: orvosh, imgClass: 'h-8' },
  { label: 'Client logo', src: mamac, imgClass: 'h-8' },
  { label: 'Client logo', src: jj, imgClass: 'h-6' },
  { label: 'Client logo', src: sherGroupWhite, imgClass: 'h-10' },
]
---

<section class="relative pt-12 pb-0">
  <div class="mx-auto max-w-5xl px-4 text-center">
    <p class="mb-8 text-p-bold font-semibold text-palette-950">{t.trustedBy}</p>
  </div>

  <div class="mx-auto max-w-5xl px-4">
    <div class="ticker-mask relative overflow-hidden">
      <div class="ticker-track flex w-max items-center">
        {[...logos, ...logos].map(({ label, icon: Icon, src, mark, imgClass = 'h-6', opacity }) => (
          <div class="flex shrink-0 items-center gap-2 px-8">
            {src ? (
              <>
                {mark && <Image src={mark} alt="" class={`logo-img ${imgClass} w-auto`} style={opacity ? `opacity:${opacity}` : undefined} loading="eager" decoding="async" />}
                <Image src={src} alt={label} class={`logo-img ${imgClass} w-auto`} style={opacity ? `opacity:${opacity}` : undefined} loading="eager" decoding="async" />
              </>
            ) : (
              <div class="flex items-center gap-2 text-palette-800">
                <Icon size={20} />
                <span class="text-h5 font-semibold whitespace-nowrap">{label}</span>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>

  <ScrollGlow client:visible className="relative z-30 mt-0 block" maxHeight={14} reserveHeight={9} />
</section>

<style>
  .ticker-mask {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  .ticker-track {
    animation: logo-ticker-scroll 15s linear infinite;
    will-change: transform;
    backface-visibility: hidden;
  }

  .logo-img {
    opacity: 0.7;
  }

  @keyframes logo-ticker-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }
</style>
