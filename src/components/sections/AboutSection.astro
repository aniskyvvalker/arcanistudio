---
import { ScrollRevealText } from '../ScrollRevealText'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang).about
---

<section class="bg-palette-950 py-[clamp(80px,10vw,128px)] rounded-t-2xl">
  <div class="mx-auto max-w-7xl px-4">
    <div class="mb-8 flex items-center gap-3">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M12 1 C12.6 7 14 10.6 22 12 C14 13.4 12.6 17 12 23 C11.4 17 10 13.4 2 12 C10 10.6 11.4 7 12 1 Z"
          fill="#F94500"
        />
      </svg>
      <p class="text-tooltip-l font-regular uppercase text-primary-600">{t.eyebrow}</p>
    </div>
    <ScrollRevealText client:visible lang={lang} />
  </div>
</section>
