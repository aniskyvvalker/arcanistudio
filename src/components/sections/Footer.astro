---
import { ArrowUpRight, X } from 'lucide-react'

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '#about' },
  { label: 'Services', href: '#services' },
  { label: 'How We Work', href: '#how-we-work' },
  { label: 'Work', href: '#portfolio' },
  { label: 'Contact', href: '#contact' },
]

const legalLinks = [
  { label: 'Privacy Policy', href: '#' },
  { label: 'Terms of Service', href: '#' },
]

const socialLinks = [
  {
    label: 'Facebook',
    href: '#',
    path: 'M14 9h3V6h-3a4 4 0 0 0-4 4v2H7v3h3v6h3v-6h3l1-3h-4v-2a1 1 0 0 1 1-1Z',
  },
  {
    label: 'Instagram',
    href: '#',
    path: 'M3 7.5A4.5 4.5 0 0 1 7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9ZM12 8.25a3.75 3.75 0 1 0 0 7.5 3.75 3.75 0 0 0 0-7.5ZM17.25 6.75h.008',
  },
  {
    label: 'LinkedIn',
    href: '#',
    path: 'M6.5 9.5h-3V20h3V9.5ZM5 4a1.75 1.75 0 1 0 0 3.5A1.75 1.75 0 0 0 5 4ZM10 9.5h3v1.46c.5-.86 1.6-1.71 3.2-1.71 2.5 0 3.8 1.5 3.8 4.6V20h-3v-5.5c0-1.4-.5-2.3-1.7-2.3-1 0-1.6.7-1.8 1.4-.1.2-.1.5-.1.8V20h-3V9.5Z',
  },
]
---

<footer class="overflow-hidden bg-palette-950 px-4 pt-16 pb-6 text-white">
  <div class="mx-auto max-w-6xl">
    <div class="grid grid-cols-2 gap-12 md:grid-cols-[1.6fr_1fr_1fr]">
      <div class="col-span-2 flex flex-col md:col-span-1 md:h-full">
        <h3 class="font-sans text-h5 font-semibold uppercase">Let's Build Something</h3>
        <p class="mt-3 max-w-xs text-tooltip-l text-palette-400">
          Drop your email and we'll reach out to discuss your project.
        </p>

        <form
          class="mt-6 flex max-w-sm items-center justify-between rounded-full border border-palette-800 bg-palette-900 p-1.5 pl-5 md:mt-auto"
          action="mailto:hello@arcanistudio.com"
          method="get"
          enctype="text/plain"
        >
          <input type="hidden" name="subject" value="New project inquiry" />
          <input
            type="email"
            name="body"
            required
            placeholder="Write your email"
            class="w-full bg-transparent text-tooltip-l text-white placeholder:text-palette-500 focus:outline-none"
          />
          <button
            type="submit"
            aria-label="Get in touch"
            class="group relative flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full bg-primary-600 text-white"
          >
            <ArrowUpRight size={18} strokeWidth={1.5} className="transition-transform duration-500 group-hover:translate-x-8" />
            <ArrowUpRight size={18} strokeWidth={1.5} className="absolute -translate-x-8 transition-transform duration-500 group-hover:translate-x-0" />
          </button>
        </form>
      </div>

      <nav aria-label="Site">
        <h4 class="font-sans text-h6 font-semibold uppercase">Menu</h4>
        <ul class="mt-4 flex flex-col gap-3 text-tooltip-l text-palette-400">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-white">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Legal">
        <h4 class="font-sans text-h6 font-semibold uppercase">Legal</h4>
        <ul class="mt-4 flex flex-col gap-3 text-tooltip-l text-palette-400">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-white">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="my-10 h-px w-full bg-palette-800"></div>

    <div class="flex flex-col items-center justify-between gap-4 min-[500px]:flex-row">
      <p class="text-tooltip-l text-palette-400">Arcani Studio. All Rights Reserved.</p>
      <div class="flex items-center gap-3">
        {socialLinks.map((social) => (
          <a
            href={social.href}
            aria-label={social.label}
            class="flex h-9 w-9 items-center justify-center rounded-full border border-palette-800 text-palette-300 transition-colors hover:border-palette-700 hover:text-white"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={social.path}></path>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="-mx-4 pb-[2.5vw]">
    <p class="select-none whitespace-nowrap text-center font-clash text-[16vw] leading-[0.9] font-medium text-primary-600 mt-[0.25em] -mb-[0.3em] scale-y-120 max-[450px]:text-[30vw]">
      <span class="max-[450px]:hidden">arcan<span class="relative inline-block">ı<!-- Logo dot replacement: dotless "ı" + positioned logo mark above it.
           Outer span: absolute-positioned, centered over the ı, 0.15em square.
           translateX(-50%) centers it. scaleY(0.833) in keyframes cancels parent scale-y-120.
           To remove spin: delete animation:logo-spin on the svg style.
           To remove logo entirely: revert ı back to i and delete this comment + span. -->
        <span class="absolute left-1/2 bottom-[75%]" style="width:0.15em;height:0.15em;transform:translateX(-50%);display:block;">
          <!-- SVG: spin animates 90deg over 1s, pauses 5s, repeats every 6s.
               scaleY(0.833) in keyframes cancels the parent p's scale-y-120 stretch. -->
          <svg
            style="width:100%;height:100%;transform-origin:center center;animation:logo-spin 5s ease-in-out infinite;"
            viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M 228 0 C 172.772 0 128 44.772 128 100 L 128 0 L 0 0 L 0 28 C 0 83.228 44.772 128 100 128 L 0 128 L 0 256 L 28 256 C 83.228 256 128 211.228 128 156 L 128 256 L 256 256 L 256 228 C 256 172.772 211.228 128 156 128 L 256 128 L 256 0 Z" fill="#F5F5F5"/>
          </svg>
        </span></span>Stud<span class="relative inline-block">ı<!-- Logo dot on "i" in "Studio": orange, static (no spin), same size as arcani logo -->
          <!-- To remove: revert ı → i and delete this span -->
          <span class="absolute left-1/2 bottom-[75%]" style="width:0.15em;height:0.15em;transform:translateX(-50%);display:block;">
            <svg
              style="width:100%;height:100%;transform-origin:center center;transform:scaleY(0.833);"
              viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M 228 0 C 172.772 0 128 44.772 128 100 L 128 0 L 0 0 L 0 28 C 0 83.228 44.772 128 100 128 L 0 128 L 0 256 L 28 256 C 83.228 256 128 211.228 128 156 L 128 256 L 256 256 L 256 228 C 256 172.772 211.228 128 156 128 L 256 128 L 256 0 Z" fill="#F94500"/>
            </svg>
          </span></span>o</span>
      <!-- Mobile only (<450px): shows "arcani" instead of "arcaniStudio" -->
      <!-- Same logo-dot trick as desktop, but logo size is 0.22em (larger, since text is 30vw) -->
      <!-- To remove: revert ı → i and delete the inner spans -->
      <span class="hidden max-[450px]:inline max-[450px]:font-semibold">arcan<span class="relative inline-block">ı
        <span class="absolute left-1/2 bottom-[75%]" style="width:0.22em;height:0.22em;transform:translateX(-50%);display:block;">
          <svg
            style="width:100%;height:100%;transform-origin:center center;animation:logo-spin 5s ease-in-out infinite;"
            viewBox="0 0 256 256" fill="none" xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M 228 0 C 172.772 0 128 44.772 128 100 L 128 0 L 0 0 L 0 28 C 0 83.228 44.772 128 100 128 L 0 128 L 0 256 L 28 256 C 83.228 256 128 211.228 128 156 L 128 256 L 256 256 L 256 228 C 256 172.772 211.228 128 156 128 L 256 128 L 256 0 Z" fill="#F5F5F5"/>
          </svg>
        </span></span></span>
    </p>
  </div>
</footer>

<style>
/*
  logo-spin: animates the Arcani logo replacing the dot of the "i" in arcaniStudio.
  - Spins 90deg over ~1s (first 17% of cycle), then holds for ~5s.
  - Total cycle: 6s, repeats infinitely.
  - scaleY(0.833) cancels the parent <p>'s scale-y-120 so the logo stays square.
  - To remove spin: delete the animation property from the SVG's inline style.
  - To slow down / speed up: change the 6s value on the SVG's animation property.
  - To change spin angle: update the 90deg value in the 17% keyframe.
*/
@keyframes logo-spin {
  0%   { transform: scaleY(0.833) rotate(0deg); }   /* start: no rotation */
  20%  { transform: scaleY(0.833) rotate(90deg); }  /* 1s in: 90deg reached */
  100% { transform: scaleY(0.833) rotate(90deg); }  /* hold until next cycle */
}
</style>
