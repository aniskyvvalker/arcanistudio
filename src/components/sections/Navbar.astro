---
import { Menu, X } from 'lucide-react'

const navLinks = [
  { label: 'Services', href: '#services' },
  { label: 'Process', href: '#how-we-work' },
  { label: 'Work', href: '#portfolio' },
  { label: 'FAQ', href: '#faq' },
  { label: 'Contact', href: '#contact' },
]
---

<header class="fixed inset-x-0 top-4 z-50 flex justify-center px-4">
  <nav
    id="main-nav"
    class="navbar-glass grid h-12 w-full max-w-7xl grid-cols-[auto_auto_1fr] items-center gap-4 rounded-full pl-4 pr-2 min-[1200px]:grid-cols-[1fr_auto_1fr]"
  >
    <a href="/" class="col-start-1 flex items-center gap-2 justify-self-start">
      <span
        class="h-[18px] w-[18px] shrink-0 bg-palette-100 [mask-image:url(/logo.svg)] [mask-size:contain] [mask-repeat:no-repeat] [mask-position:center]"
        role="img"
        aria-label="Arcani Studio"
      ></span>
      <span class="hidden text-tooltip-l font-medium leading-tight text-palette-200 whitespace-nowrap min-[1200px]:inline">Digital Solutions With Purpose</span>
      <span class="font-clash text-[24px] leading-tight font-medium text-white whitespace-nowrap min-[1200px]:hidden">ArcaniStudio</span>
    </a>

    <span class="col-start-2 hidden font-clash text-[24px] leading-tight font-medium text-white whitespace-nowrap justify-self-center min-[1200px]:block">ArcaniStudio</span>

    <div class="col-start-3 flex items-center justify-end gap-2 justify-self-end">
      <ul class="hidden items-center gap-0 text-p-regular font-normal md:flex">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link px-2 py-1.5"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <a
        id="cta-btn"
        href="#contact"
        class="shrink-0 overflow-hidden whitespace-nowrap rounded-full bg-primary-600 px-4 py-2 text-tooltip-l font-medium text-white transition-colors duration-700 hover:bg-white hover:text-black"
      >
        <span id="cta-inner" class="flex items-center gap-3">
          <span id="cta-chevron" style="display:inline-flex;flex-shrink:0;transition:transform 0.7s cubic-bezier(0.22,1,0.36,1)"><svg width="6" height="11" viewBox="0 0 8 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <span id="cta-text" style="transition:transform 0.7s cubic-bezier(0.22,1,0.36,1)">Book a call</span>
        </span>
      </a>
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        class="flex h-9 w-9 items-center justify-center rounded-full text-white transition-colors duration-200 hover:bg-white/8 md:hidden"
      >
        <span id="menu-icon-open"><Menu size={18} /></span>
        <span id="menu-icon-close" class="hidden"><X size={18} /></span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu drawer -->
  <div
    id="mobile-menu"
    class="mobile-menu-glass absolute inset-x-4 top-[calc(100%+8px)] hidden rounded-2xl p-4"
    role="dialog"
    aria-label="Navigation menu"
  >
    <ul class="flex flex-col gap-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link block rounded-xl px-4 py-3 text-base font-medium text-palette-200 transition-colors duration-200 hover:bg-white/8 hover:text-white"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="mt-3 border-t border-white/8 pt-3">
      <a
        href="#contact"
        class="block w-full rounded-xl bg-primary-600 px-4 py-3 text-center text-base font-medium text-white transition-colors duration-200 hover:bg-primary-700"
      >
        Get started
      </a>
    </div>
  </div>
</header>

<style>
  .navbar-glass {
    background: rgba(8, 8, 8, 0.7);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 0.5px solid rgba(255, 255, 255, 0.08);
    /* Original bevel (top highlight, bottom shadow):
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.10),
      inset 0 -1px 0 0 rgba(0, 0, 0, 0.20),
      0 8px 32px rgba(0, 0, 0, 0.28),
      0 2px 8px rgba(0, 0, 0, 0.18);
    */
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.10),
      0 8px 32px rgba(0, 0, 0, 0.28),
      0 2px 8px rgba(0, 0, 0, 0.18);
    animation: nav-drop-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .mobile-menu-glass {
    background: rgba(8, 8, 8, 0.72);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.08),
      0 16px 48px rgba(0, 0, 0, 0.4),
      0 4px 16px rgba(0, 0, 0, 0.24);
  }

  @keyframes nav-drop-in {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .nav-link {
    position: relative;
    padding: 0.375rem 0.5rem;
    color: white;
    text-decoration: none;
    transition: color 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  ul:hover .nav-link {
    opacity: 0.6;
  }

  ul:hover .nav-link:hover {
    opacity: 1;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 0.5rem;
    right: 0.5rem;
    height: 1.5px;
    background: #ffffff;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar-glass {
      animation: none;
    }
    .mobile-menu-glass {
      transition: none;
    }
    .nav-link::after {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle')
  const menu = document.getElementById('mobile-menu')
  const iconOpen = document.getElementById('menu-icon-open')
  const iconClose = document.getElementById('menu-icon-close')

  function openMenu() {
    menu!.classList.remove('hidden')
    menu!.classList.add('block')
    toggle!.setAttribute('aria-expanded', 'true')
    iconOpen!.classList.add('hidden')
    iconClose!.classList.remove('hidden')
  }

  function closeMenu() {
    menu!.classList.add('hidden')
    menu!.classList.remove('block')
    toggle!.setAttribute('aria-expanded', 'false')
    iconOpen!.classList.remove('hidden')
    iconClose!.classList.add('hidden')
  }

  toggle?.addEventListener('click', () => {
    const isOpen = menu!.classList.contains('block')
    isOpen ? closeMenu() : openMenu()
  })

  // Close on nav link click
  menu?.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', closeMenu)
  })

  // CTA chevron swap
  window.addEventListener('load', () => {
    const ctaBtn = document.getElementById('cta-btn') as HTMLAnchorElement | null
    const chev = document.getElementById('cta-chevron') as HTMLElement | null
    const ctaText = document.getElementById('cta-text') as HTMLElement | null
    ctaBtn?.addEventListener('mouseenter', () => {
      if (!chev || !ctaText) return
      const textW = ctaText.offsetWidth
      chev.style.transform = `translateX(${textW + 12}px)`
      ctaText.style.transform = `translateX(-18px)`
    })
    ctaBtn?.addEventListener('mouseleave', () => {
      if (chev) chev.style.transform = 'translateX(0)'
      if (ctaText) ctaText.style.transform = 'translateX(0)'
    })
  })

  // Close on outside click
  document.addEventListener('click', (e) => {
    const header = document.querySelector('header')
    if (!header!.contains(e.target as Node)) {
      closeMenu()
    }
  })
</script>
