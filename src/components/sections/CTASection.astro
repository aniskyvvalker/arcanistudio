---
import { ChevronRight, Sparkles } from 'lucide-react'
/**
 * OPTION 1 — WebGL Shader Gradient (commented)
 * Best visual, highest GPU cost, may cause scroll jank.
 * To activate: uncomment line below + <ShaderGradientBackground> in HTML.
 * Comment out OPTION 2 or 3 CSS + HTML when switching.
 *
 */
import { ShaderGradientBackground } from '../ShaderGradientBackground'
---

<style>
  /* ═══════════════════════════════════════════════════════════════════════════
     OPTION 2 — Animated CSS gradient (ACTIVE)
     Zero WebGL. background-position animation. May cause minor repaint jank.
     To switch away: comment the @keyframes + .cta-gradient block below.
     ═══════════════════════════════════════════════════════════════════════════ */
  /*
  @keyframes gradient-shift {
    0%   { background-position: 0% 50%; }
    25%  { background-position: 100% 0%; }
    50%  { background-position: 100% 100%; }
    75%  { background-position: 0% 100%; }
    100% { background-position: 0% 50%; }
  }
  .cta-gradient {
    background: linear-gradient(135deg, #73bfc4, #ff810a, #8da0ce, #ff810a, #73bfc4);
    background-size: 400% 400%;
    animation: gradient-shift 10s ease infinite;
  }
  */

  /* cycle: hold white 3s → 0.5s transition to orange → hold orange 3s → 0.5s back */
  @keyframes cta-btn-pulse {
    0%     { background-color: #ffffff; color: #0A0A0A; }
    7.14%  { background-color: #F94500; color: #ffffff; }
    50%    { background-color: #F94500; color: #ffffff; }
    57.14% { background-color: #ffffff; color: #0A0A0A; }
    100%   { background-color: #ffffff; color: #0A0A0A; }
  }
  @keyframes cta-circle-pulse {
    0%     { background-color: #F94500; color: #ffffff; }
    7.14%  { background-color: #ffffff; color: #0A0A0A; }
    50%    { background-color: #ffffff; color: #0A0A0A; }
    57.14% { background-color: #F94500; color: #ffffff; }
    100%   { background-color: #F94500; color: #ffffff; }
  }
  .cta-btn {
    animation: cta-btn-pulse 7s ease-in-out infinite;
  }
  .cta-btn-circle {
    animation: cta-circle-pulse 7s ease-in-out infinite;
  }

  /* ═══════════════════════════════════════════════════════════════════════════
     OPTION 3 — Static gradient + SVG grain (ACTIVE)
     Zero animation, zero jank.
     ═══════════════════════════════════════════════════════════════════════════ */
  .cta-gradient {
    background: linear-gradient(135deg, #73bfc4 0%, #ff810a 50%, #8da0ce 100%);
  }
  .cta-grain {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 1;
    opacity: 1;
  }
</style>

<div class="bg-palette-950">
<section
  class="cta-gradient relative isolate flex min-h-screen flex-col items-center justify-center overflow-hidden rounded-2xl text-center"
>
  <!-- OPTION 1: WebGL shader — uncomment to activate
  <ShaderGradientBackground client:only="react" />
  -->

  <!-- OPTION 3: SVG grain (ACTIVE) -->
  <svg class="cta-grain" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" style="position:absolute;inset:0;z-index:1;opacity:1;pointer-events:none;border-radius:inherit">
    <filter id="cta-noise">
      <feTurbulence type="fractalNoise" baseFrequency="0.72" numOctaves="4" stitchTiles="stitch" />
    </filter>
    <rect width="100%" height="100%" filter="url(#cta-noise)" />
  </svg>

  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(255,255,255,0.12)_0%,transparent_55%)]"></div>

  <div class="relative z-10 mx-auto flex max-w-4xl flex-col items-center gap-6 px-4">
    <div class="flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1 text-tooltip-l text-white">
      <span class="flex items-center gap-1 rounded-full bg-white px-2 py-0.5 text-tooltip-s font-semibold uppercase text-primary-600">
        <Sparkles size={10} />
        Let's talk
      </span>
      <span>Now booking projects for next quarter</span>
    </div>

    <h2 class="text-[clamp(40px,11.27vw,96px)] font-semibold leading-[1.05] text-white">
      Ready to build<br /><span class="font-reckless">something great?</span>
    </h2>

    <p class="max-w-xl text-h6 text-white/80">
      Tell us about your project and let's turn your idea into a product people love.
    </p>

    <a
      href="#contact"
      class="cta-btn group flex items-center gap-3 rounded-full bg-white py-2 pl-5 pr-2 text-[16px] font-light text-palette-950"
    >
      <span class="relative h-[1.2em] overflow-hidden">
        <span class="flex h-full items-center transition-transform duration-500 group-hover:-translate-y-[150%]">Start Your Project</span>
        <span class="absolute left-0 top-0 flex h-full translate-y-[150%] items-center transition-transform duration-500 group-hover:translate-y-0">Start Your Project</span>
      </span>
      <span class="cta-btn-circle relative flex h-8 w-8 items-center justify-center overflow-hidden rounded-full bg-primary-600 text-white">
        <ChevronRight size={24} strokeWidth={1.5} className="transition-transform duration-500 group-hover:translate-x-8" />
        <ChevronRight size={24} strokeWidth={1.5} className="absolute -translate-x-8 transition-transform duration-500 group-hover:translate-x-0" />
      </span>
    </a>
  </div>
</section>
</div>

