---
// Shared shell for /privacy and /terms — both locales, both docs. Deliberately
// skips the full marketing <Navbar /> (its nav links are #services/#about-style
// in-page anchors that don't exist on this page, so they'd just no-op) in favor
// of a minimal logo + back-home header. Footer is reused as-is for consistent
// site chrome, including the now-real legal links pointing back at this page.
import '../styles/global.css'
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import GoogleAnalytics from './GoogleAnalytics.astro'
import Clarity from './Clarity.astro'
import Footer from './sections/Footer.astro'
import { getLangFromUrl, useTranslations, getAlternateUrls, localizePath } from '../i18n/utils'

interface Props {
  doc: 'privacy' | 'terms'
}

const { doc } = Astro.props

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const content = t.legal[doc]
const path = doc === 'privacy' ? '/privacy' : '/terms'

const alternates = getAlternateUrls(Astro.site, path)
const canonicalURL = lang === 'fr' ? alternates.fr : alternates.en
const homeHref = localizePath('/', lang)
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{content.metaTitle}</title>
    <meta name="description" content={content.metaDescription} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="fr" href={alternates.fr} />
    <link rel="alternate" hreflang="x-default" href={alternates.xDefault} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={content.metaTitle} />
    <meta property="og:description" content={content.metaDescription} />
    <meta property="og:url" content={canonicalURL} />
  </head>
  <body>
    <header class="px-4 pt-6 md:px-8 md:pt-8">
      <a href={homeHref} class="inline-flex items-center gap-2 text-p-regular font-medium text-palette-950 transition-opacity hover:opacity-70">
        <span
          class="h-[18px] w-[18px] shrink-0 bg-palette-950 [mask-image:url(/logo.svg)] [mask-size:contain] [mask-repeat:no-repeat] [mask-position:center]"
          role="img"
          aria-label="Arcani Studio"
        ></span>
        {t.legal.backHome}
      </a>
    </header>

    <main class="mx-auto max-w-4xl px-4 pt-20 pb-24 leading-relaxed tracking-wide [word-spacing:0.06em] md:px-8 md:pt-28">
      <h1 class="font-sans text-[clamp(32px,4vw,48px)] font-medium leading-tight tracking-normal [word-spacing:normal] text-palette-950">{content.heading}</h1>
      <p class="mt-16 text-tooltip-l text-palette-500">{content.lastUpdated}</p>
      <p class="mt-6 text-p-regular leading-relaxed text-palette-700">{content.intro}</p>

      <div class="mt-12 flex flex-col gap-10">
        {content.sections.map((section, i) => (
          <section>
            <h2 class="font-sans text-h6 font-semibold tracking-normal [word-spacing:normal] text-palette-950">{i + 1}. {section.heading}</h2>
            <div class="mt-3 flex flex-col gap-3">
              {section.content.map((block) =>
                Array.isArray(block) ? (
                  <ul class="flex list-disc flex-col gap-2 pl-5 text-p-regular leading-relaxed text-palette-700 marker:text-palette-400">
                    {block.map((item) => <li>{item}</li>)}
                  </ul>
                ) : (
                  <p class="text-p-regular leading-relaxed text-palette-700">{block}</p>
                )
              )}
            </div>
          </section>
        ))}
      </div>
    </main>

    <Footer />
    <Analytics />
    <SpeedInsights />
    <GoogleAnalytics />
    <Clarity />
  </body>
</html>
