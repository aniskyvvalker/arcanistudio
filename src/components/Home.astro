---
import '../styles/global.css'
import Navbar from './sections/Navbar.astro'
import HeroHeader from './sections/HeroHeader.astro'
import LogoList from './sections/LogoList.astro'
import StatsSection from './sections/StatsSection.astro'
import ServicesSection from './sections/ServicesSection.astro'
import AboutSection from './sections/AboutSection.astro'
import HowWeWork from './sections/HowWeWork.astro'
import PortfolioTestimonial from './sections/PortfolioTestimonial.astro'
import LogoDivider from './sections/LogoDivider.astro'
import LogoDividerReverse from './sections/LogoDividerReverse.astro'
import TestimonialsSection from './sections/TestimonialsSection'
import FAQSection from './sections/FAQSection.astro'
import CTASection from './sections/CTASection.astro'
import ContactSection from './sections/ContactSection'
import Footer from './sections/Footer.astro'
import LanguageBanner from './LanguageBanner'
import { getLangFromUrl, useTranslations, getAlternateUrls } from '../i18n/utils'

// Locale is derived from the URL, so this single component renders both the
// English (/) and French (/fr) homepages — every child reads the same lang.
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Home.astro only ever renders the homepage itself (both '/' and '/fr' route
// here), so the delocalized path is always '/' — not Astro.url.pathname,
// which already carries the '/fr' prefix and would double it up.
const alternates = getAlternateUrls(Astro.site, '/')
const canonicalURL = lang === 'fr' ? alternates.fr : alternates.en
const ogImageURL = new URL('/og-image.jpg', Astro.site).toString()
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US'
const ogLocaleAlternate = lang === 'fr' ? 'en_US' : 'fr_FR'

// JSON-LD: Organization (no street address — none exists in the site's copy;
// see FAQPage below for the rich-snippet FAQ markup) + FAQPage from the same
// FAQ content the page already renders, so the two never drift apart.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'arcaniStudio',
  url: Astro.site?.toString(),
  logo: new URL('/logo.svg', Astro.site).toString(),
  image: ogImageURL,
  description: t.meta.description,
  areaServed: 'Algeria',
  availableLanguage: ['English', 'French'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    availableLanguage: ['English', 'French'],
  },
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
}
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="fr" href={alternates.fr} />
    <link rel="alternate" hreflang="x-default" href={alternates.xDefault} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.homeTitle} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <Navbar />
    <main>
      <div class="hero-gradient relative isolate overflow-hidden bg-background-light">
        <HeroHeader />
        <LogoList />
        {/*
          lg+ vignette: fades the wormhole's outer rim into the page bg, leaving
          the center (content + funnel) clear. Spans the whole hero+ticker wrapper
          so the fade reaches down to the glow separator.

          The two gradient stops control the fade band (as % of the ellipse radius):
            - `transparent X%` = clear center; below this, no fade.
            - `#F8F6F1 Y%`     = fully page-color; beyond this, lines are erased.
          Lower X/Y = band pulled inward = stronger, more lines erased.

          ACTIVE (medium):  transparent 45% / cream 77%
          ALT (stronger):   transparent 40% / cream 70%  — swap the class below to use it.
        */}
        <div class="pointer-events-none absolute inset-0 z-20 hidden lg:block bg-[radial-gradient(ellipse_75%_90%_at_50%_60%,transparent_0%,transparent_45%,#F8F6F1_77%)]"></div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 block h-60 bg-[radial-gradient(circle_250px_at_bottom_left,#F8F6F1_0%,transparent_60%),radial-gradient(circle_250px_at_bottom_right,#F8F6F1_0%,transparent_60%),linear-gradient(to_top,#F8F6F1_0%,transparent_55%)]"></div>
      </div>
      <StatsSection />
      <div id="services"><ServicesSection /></div>
      <AboutSection />
      <div id="how-we-work"><HowWeWork /></div>
      <LogoDivider />
      <div id="portfolio"><PortfolioTestimonial /></div>
      <LogoDividerReverse />
      <TestimonialsSection client:visible lang={lang} />
      <div id="faq"><FAQSection /></div>
      <div class="bg-palette-950 py-6 md:py-8"></div>
      <CTASection />
      <div id="contact"><ContactSection client:visible lang={lang} /></div>
    </main>
    <Footer />
    <LanguageBanner client:load lang={lang} />
  </body>
</html>

<!--
  Smooth/eased scroll (Lenis), added for a slower "premium" scroll feel.
  To fully revert to native browser scroll:
    1. Delete this whole <script> block below.
    2. In src/styles/global.css, restore the `html { scroll-behavior: smooth }`
       + prefers-reduced-motion override — see comment there for the exact snippet.
    3. Optionally `npm uninstall lenis` (only used here).
-->
<script>
  import Lenis from 'lenis'

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (!prefersReducedMotion) {
    // duration: seconds to settle after a scroll input — higher = slower/heavier feel.
    // Was 1.2 (Lenis default) -> 1.3 -> settled on 1.25 per user tuning.
    const lenis = new Lenis({ duration: 1.25 })

    function raf(time: number) {
      lenis.raf(time)
      requestAnimationFrame(raf)
    }
    requestAnimationFrame(raf)

    // Lenis only smooths wheel/touch input by default — it does NOT catch
    // clicks on in-page anchor links (navbar, "Discover", "Réserver un
    // créneau", etc). Without this, those still native-jump since CSS
    // scroll-behavior is off. Route any `#hash` link through Lenis instead.
    document.addEventListener('click', (e) => {
      const anchor = (e.target as HTMLElement).closest('a[href^="#"]')
      if (!anchor) return
      const id = anchor.getAttribute('href')?.slice(1)
      if (!id) return
      const target = document.getElementById(id)
      if (!target) return
      e.preventDefault()
      lenis.scrollTo(target)
      // preventDefault() above also blocks the browser's native URL-hash update
      // (that's why the address bar no longer shows #contact/#services after
      // clicking, unlike before this handler existed). To restore it:
      //   history.pushState(null, '', anchor.getAttribute('href'))
    })
  }
</script>
