---
import '../styles/global.css'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex" />
    <title>Page not found — arcaniStudio</title>
  </head>
  <body class="overflow-hidden bg-palette-950">
    <main class="relative flex min-h-dvh items-center justify-center">

      {/* Giant 404 — bottom on mobile, full-bleed centered on desktop */}
      <div
        class="num404 pointer-events-none absolute inset-0 flex items-end justify-center text-[68vw] md:items-center md:text-[min(160vh,65vw)] font-reckless leading-none text-white"
        style="font-weight: 100; paint-order: stroke fill;"
        aria-hidden="true"
      >
        <span class="digit digit-1">4</span>
        <span class="digit digit-2 text-primary-600" style="margin-inline: -0.12em;">0</span>
        <span class="digit digit-3">4</span>
      </div>

      {/* Centered overlay content */}
      <div class="overlay-content relative z-10 flex flex-col items-center gap-4 px-5 text-center md:translate-y-[6vh]">
        <h1 class="err-title font-reckless text-white">
          <span class="fs" style="--d:0s">Page</span>
          <span class="fs" style="--d:.1s"> Not</span>
          <span class="fs" style="--d:.2s"> Available</span>
        </h1>
        <p class="text-[14px] leading-relaxed text-white">
          <span class="fs" style="--d:.35s">Sorry, this page isn't available</span><br />
          <span class="fs" style="--d:.45s">anymore or an error occurred.</span>
        </p>
        <span class="fs" style="--d:.6s">
        <a
          href="/"
          class="group mt-2 flex items-center gap-2 rounded-full bg-white px-5 py-3 text-[16px] font-light text-palette-950 transition-colors duration-200 hover:bg-palette-100"
        >
          Back home
          <svg class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7M7 7h10v10" />
          </svg>
        </a>
        </span>
      </div>

    <style>
      /* 28px @355px → 40px @767px */
      .err-title { font-size: clamp(28px, calc(2.91vw + 17.66px), 40px); }
      /* 25px @768px → 40px @1270px */
      @media (min-width: 768px) {
        .err-title { font-size: clamp(25px, calc(2.99vw + 2.05px), 40px); }
      }

      .num404 {
        -webkit-text-stroke-color: #0A0A0A;
        -webkit-text-stroke-width: 8px;
      }
      @media (min-width: 768px) {
        /* grows 8px → 15px between 768px and 1920px viewport */
        .num404 { -webkit-text-stroke-width: clamp(8px, calc(0.6vw + 3.4px), 15px); }
      }

      @keyframes blurIn {
        from { opacity: 0; filter: blur(0.18em); }
        to   { opacity: 1; filter: blur(0); }
      }
      @keyframes contentIn {
        from { opacity: 0; transform: translateY(18px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .digit {
        opacity: 0;
        animation: blurIn 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }
      .digit-1 { animation-delay: 0.05s; }
      .digit-2 { animation-delay: 0.2s; }
      .digit-3 { animation-delay: 0.35s; }

      .overlay-content { opacity: 1; }

      /* OPTION 4 — fade stagger (liked)
      @keyframes fadeStagger {
        from { opacity: 0; }
        to   { opacity: 1; }
      } */

      /* OPTION 5 — clip reveal (liked)
      @keyframes clipReveal {
        from { clip-path: inset(0 100% 0 0); }
        to   { clip-path: inset(0 0% 0 0); }
      }
      .fs {
        display: inline-block;
        clip-path: inset(0 100% 0 0);
        animation: clipReveal 0.5s cubic-bezier(0.22, 1, 0.36, 1) calc(0.8s + var(--d)) forwards;
      } */

      @keyframes fadeBlurStagger {
        from { opacity: 0; filter: blur(6px); }
        to   { opacity: 1; filter: blur(0); }
      }
      .fs {
        display: inline-block;
        opacity: 0;
        animation: fadeBlurStagger 1.2s cubic-bezier(0.22, 1, 0.36, 1) calc(0.8s + var(--d)) forwards;
      }
    </style>
  </body>
</html>
