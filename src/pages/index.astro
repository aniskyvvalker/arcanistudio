---
import '../styles/global.css'
import Navbar from '../components/sections/Navbar.astro'
import HeroHeader from '../components/sections/HeroHeader.astro'
import LogoList from '../components/sections/LogoList.astro'
import StatsSection from '../components/sections/StatsSection.astro'
import ServicesSection from '../components/sections/ServicesSection.astro'
import AboutSection from '../components/sections/AboutSection.astro'
import HowWeWork from '../components/sections/HowWeWork.astro'
import PortfolioTestimonial from '../components/sections/PortfolioTestimonial.astro'
import LogoDivider from '../components/sections/LogoDivider.astro'
import LogoDividerReverse from '../components/sections/LogoDividerReverse.astro'
import TestimonialsSection from '../components/sections/TestimonialsSection'
import CTASection from '../components/sections/CTASection.astro'
import ContactSection from '../components/sections/ContactSection.astro'
import Footer from '../components/sections/Footer.astro'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>arcaniStudio</title>
  </head>
  <body>
    <Navbar />
    <main>
      <div class="hero-gradient relative isolate overflow-hidden bg-background-light">
        <HeroHeader />
        <LogoList />
      </div>
      <StatsSection />
      <ServicesSection />
      <AboutSection />
      <HowWeWork />
      <LogoDivider />
      <PortfolioTestimonial />
      <LogoDividerReverse />
      <TestimonialsSection client:visible />
      <!-- <CTASection /> -->
      <ContactSection />
    </main>
    <Footer />
  </body>
</html>
