---
import '../styles/global.css'
import Navbar from '../components/sections/Navbar.astro'
import HeroHeader from '../components/sections/HeroHeader.astro'
import LogoList from '../components/sections/LogoList.astro'
import StatsSection from '../components/sections/StatsSection.astro'
import ServicesSection from '../components/sections/ServicesSection.astro'
import AboutSection from '../components/sections/AboutSection.astro'
import HowWeWork from '../components/sections/HowWeWork.astro'
import PortfolioTestimonial from '../components/sections/PortfolioTestimonial.astro'
import LogoDivider from '../components/sections/LogoDivider.astro'
import LogoDividerReverse from '../components/sections/LogoDividerReverse.astro'
import TestimonialsSection from '../components/sections/TestimonialsSection'
import FAQSection from '../components/sections/FAQSection.astro'
import CTASection from '../components/sections/CTASection.astro'
import ContactSection from '../components/sections/ContactSection'
import Footer from '../components/sections/Footer.astro'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>arcaniStudio</title>
  </head>
  <body>
    <Navbar />
    <main>
      <div class="hero-gradient relative isolate overflow-hidden bg-background-light">
        <HeroHeader />
        <LogoList />
        {/*
          lg+ vignette: fades the wormhole's outer rim into the page bg, leaving
          the center (content + funnel) clear. Spans the whole hero+ticker wrapper
          so the fade reaches down to the glow separator.

          The two gradient stops control the fade band (as % of the ellipse radius):
            - `transparent X%` = clear center; below this, no fade.
            - `#F8F6F1 Y%`     = fully page-color; beyond this, lines are erased.
          Lower X/Y = band pulled inward = stronger, more lines erased.

          ACTIVE (medium):  transparent 45% / cream 77%
          ALT (stronger):   transparent 40% / cream 70%  — swap the class below to use it.
        */}
        <div class="pointer-events-none absolute inset-0 z-20 hidden lg:block bg-[radial-gradient(ellipse_75%_90%_at_50%_60%,transparent_0%,transparent_45%,#F8F6F1_77%)]"></div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 block h-60 bg-[radial-gradient(circle_250px_at_bottom_left,#F8F6F1_0%,transparent_60%),radial-gradient(circle_250px_at_bottom_right,#F8F6F1_0%,transparent_60%),linear-gradient(to_top,#F8F6F1_0%,transparent_55%)]"></div>
      </div>
      <StatsSection />
      <div id="services"><ServicesSection /></div>
      <AboutSection />
      <div id="how-we-work"><HowWeWork /></div>
      <LogoDivider />
      <div id="portfolio"><PortfolioTestimonial /></div>
      <LogoDividerReverse />
      <TestimonialsSection client:visible />
      <div id="faq"><FAQSection /></div>
      <div class="bg-palette-950 py-6 md:py-8"></div>
      <CTASection />
      <div id="contact"><ContactSection client:visible /></div>
    </main>
    <Footer />
  </body>
</html>
